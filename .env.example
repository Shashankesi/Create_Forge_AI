# CreateForge AI Platform - Environment Variables Template
# Domain: https://createforgeai.tech

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database URI
MONGODB_URI=mongodb://localhost:27017/createforge_ai

# JWT Authentication
JWT_SECRET=createforge_ai_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# AI Provider API Keys
# Official Google Gemini API Key (text models): https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (text models): https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Pollinations.ai / FLUX API Key (FLUX image models): https://enter.pollinations.ai
POLLINATIONS_API_KEY=your_pollinations_api_key_here
FLUX_API_KEY=your_flux_api_key_here

# Optional Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
