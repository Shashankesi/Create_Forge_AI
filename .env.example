# CreateForge AI Configuration Template
NODE_ENV=production
PORT=5000

# Frontend origin URL (used for CORS allowlisting)
# Set to the deployed frontend URL on Render:
CLIENT_URL=https://create-forge-ai-1.onrender.com

# Database URI (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/createforge_ai

# JWT Authentication
JWT_SECRET=your_production_jwt_secret_key
JWT_EXPIRES_IN=7d

# AI Provider API Keys
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
POLLINATIONS_API_KEY=your_pollinations_api_key
FLUX_API_KEY=your_flux_api_key
