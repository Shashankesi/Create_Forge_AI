# CreateForge AI - Client Environment Configuration
# API Backend URL (Vite environment variables must start with VITE_)
#
# Local development (Vite dev server proxies /api to localhost:5000):
# VITE_API_URL=http://localhost:5000/api
#
# Production (must be set to the deployed backend URL):
# VITE_API_URL=https://create-forge-ai.onrender.com/api
#
# IMPORTANT: On Render Static Site, this variable MUST be set in the
# Render Dashboard → Environment → Environment Variables BEFORE building.
# Vite embeds env vars at build time — they cannot be injected at runtime.
VITE_API_URL=http://localhost:5000/api
