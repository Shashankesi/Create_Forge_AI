# CreateForge AI Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database URI (MongoDB Atlas or local)
MONGODB_URI=mongodb://localhost:27017/createforge_ai

# JWT Authentication Secret & Expiration
JWT_SECRET=createforge_ai_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# AI Provider API Keys
# Official Google Gemini API Key (for text models): https://aistudio.google.com/
GEMINI_API_KEY=

# Groq API Key (for fast fallback text models): https://console.groq.com/
GROQ_API_KEY=

# Pollinations.ai / FLUX API Key (for FLUX image generation): https://enter.pollinations.ai
POLLINATIONS_API_KEY=your_pollinations_api_key
FLUX_API_KEY=your_flux_api_key

# Optional Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
